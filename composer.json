{
  "name": "fghazaleh/cport",
  "description": "Static, consistent wrappers for PHP's array, string and math functions",
  "type": "library",
  "require": {
    "php": ">=8.5",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpunit/phpunit": "^12.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Ghazaleh",
      "email": "franco.ghazaleh@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "FG\\Support\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "cs": "php-cs-fixer fix --dry-run --diff --show-progress=none",
    "cs:fix": "php-cs-fixer fix",
    "check": [
      "@cs",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "autoload-dev": {
    "psr-4": {
      "FG\\Support\\": "tests/"
    }
  }
}
